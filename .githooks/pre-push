#!/usr/bin/env bash
set -eu
AUTHORIZED_EMAIL="matiailearninghub@gmail.com"
TRAILER_RE='(Co-authored-by:|Generated-by:|Signed-off-by: MonkeyCode|Co-Authored-By:)'

remote_name="${1:-}"
remote_url="${2:-}"

zero="0000000000000000000000000000000000000000"
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ] || [ -z "$remote_sha" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  for c in $(git rev-list "$range"); do
    ae="$(git log -1 --format='%ae' "$c")"
    ce="$(git log -1 --format='%ce' "$c")"
    subj="$(git log -1 --format='%s%n%b' "$c")"
    if [ "$ae" != "$AUTHORIZED_EMAIL" ] || [ "$ce" != "$AUTHORIZED_EMAIL" ]; then
      echo "pre-push: commit $c author=<$ae> committer=<$ce> is not authorized" >&2
      fail=1
    fi
    if printf '%s\n' "$subj" | grep -Eiq "$TRAILER_RE"; then
      echo "pre-push: commit $c message contains a forbidden trailer" >&2
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  echo "pre-push rejected ($remote_name $remote_url)" >&2
  exit 1
fi
exit 0
