# Banglar Voice — Next.js frontend environment template
# Copy to .env.local for local dev. Vercel: Project → Settings → Environment Variables.
# Values are placeholders only. Never commit real secrets.
#
# Each var is tagged:
#   Scope: Production / Preview / Both
#   Surface: Server-only / Public
#
# Canonical public site: https://banglarvoice24news.com
# Public feed: /api/public/feed.json
#
# Supabase project refs (do not mix them):
#   Prod (Singapore): https://rcffuqkofvuezgbjcixj.supabase.co
#   Dev  (Tokyo):     https://fqqdpngmftoddffvdukn.supabase.co
# AUDIT: production NEXT_PUBLIC_SUPABASE_URL must be the Prod ref, not Dev.

# --- Required ---

# Public site origin, no trailing slash. Sitemap, RSS, OG URLs.
# Both | Public
NEXT_PUBLIC_SITE_URL=https://banglarvoice24news.com

# Supabase REST/Realtime URL (anon client). Dev default below; Prod must use rcffuqkofvuezgbjcixj.
# Both | Public
NEXT_PUBLIC_SUPABASE_URL=https://fqqdpngmftoddffvdukn.supabase.co

# Supabase anon (publishable) key. Browser-safe only because RLS is on.
# Both | Public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. Bypasses RLS. Never NEXT_PUBLIC_. Vercel: Production + Preview, Server-only.
# Both | Server-only
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingest / newsroom (server) ---

# Shared secret for POST /api/newsroom/ingest. Authorization: Bearer <key>
# Missing/change-me → HTTP 500 ingest_unconfigured. Wrong key → HTTP 401.
# Both | Server-only
NEWSROOM_INGEST_KEY=

# Direct Postgres URL for control-plane admin (vault/users/audit).
# Both | Server-only
SUPABASE_DB_URL=

# Alias used by /api/health fallback if NEXT_PUBLIC_SUPABASE_URL is unset.
# Both | Server-only
SUPABASE_URL=

# --- Optional public ---

# Legacy e-paper / PocketBase origin. Empty in production. Rewrites gated by ENABLE_LEGACY_POCKETBASE.
# Preview | Public
NEXT_PUBLIC_API_URL=

# Live stream fallback URL for /api/public/channels.json and stream.json.
# Both | Public
NEXT_PUBLIC_STREAM_URL=

# Sentry browser+server DSN (public by design).
# Production | Public
NEXT_PUBLIC_SENTRY_DSN=

# Plausible analytics.
# Production | Public
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

# --- P0: do not put secrets on NEXT_PUBLIC_ ---
# These names exist in client components today. They ship to the browser bundle.
# Do NOT set real SERVICE_ROLE / OPENAI / Stripe secrets on any NEXT_PUBLIC_ var.
# Prefer a server route proxy. Leave empty in production until that proxy exists.

# P0 leak surface — ElevenLabs key in client bundle if set.
# Preview | Public (unsafe if filled)
NEXT_PUBLIC_ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=

# P0 leak surface — chat AI key in client bundle if set.
# Preview | Public (unsafe if filled)
NEXT_PUBLIC_CHAT_AI_URL=
NEXT_PUBLIC_CHAT_AI_KEY=

# --- Optional server ---

# YouTube Data API (scripts: sync-youtube-videos.js). Not used by Next runtime routes.
# Preview | Server-only
YOUTUBE_API_KEY=

# YouTube OAuth for studio connect.
# Both | Server-only
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# GitHub Actions dispatch from admin verification run.
# Production | Server-only
GITHUB_DISPATCH_TOKEN=

# Enable /api/backend/* rewrite to NEXT_PUBLIC_API_URL. Forced off when NODE_ENV=production.
# Preview | Server-only
ENABLE_LEGACY_POCKETBASE=

# Stripe (checkout route is mock; keep server-only when wired).
# Production | Server-only
STRIPE_SECRET_KEY=
