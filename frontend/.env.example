# Banglar Voice — Next.js frontend environment template
# Copy to .env.local for local dev.
# Production: set these on the EXISTING Vercel Hobby project
# (matiailearninghub-3927) → Settings → Environment Variables.
# Do not create a second Vercel team or co-authorize another Gmail.
#
# Canonical site: https://banglarvoice24news.com
# Public feed:    /api/public/feed.json
# Linked GitHub:  MATI-AI-HUB/automation-king-
# Linked Supabase: fqqdpngmftoddffvdukn (Tokyo)

# Public site origin (no trailing slash). Used by sitemap/feed absolute URLs.
NEXT_PUBLIC_SITE_URL=https://banglarvoice24news.com

# Supabase — copy from Project Settings → API. Anon key is browser-safe (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://fqqdpngmftoddffvdukn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional legacy e-paper API origin. Leave empty unless a dedicated e-paper
# service is configured. Production must not fall back to loopback.
# Local rewrite /api/backend/* is gated by ENABLE_LEGACY_POCKETBASE=true and
# is disabled when NODE_ENV=production.
NEXT_PUBLIC_API_URL=

# Server-only. Required by admin APIs and POST /api/newsroom/ingest.
# Never expose to the browser. Leave unset locally if not ingesting.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for worker POST /api/newsroom/ingest (header x-ingest-key).
# Must not be empty or change-me, or ingest returns 503.
NEWSROOM_INGEST_KEY=

NEXT_PUBLIC_SENTRY_DSN=
