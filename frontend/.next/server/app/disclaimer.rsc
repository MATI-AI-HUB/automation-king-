) মধ্য দিয়ে যায়। AI সম্পূর্ণ স্বাধীনভাবে প্রকাশ করে না।"}]}]]}],["$","section",null,{"id":"accuracy","className":"scroll-mt-24 border-t border-border/60 pt-6","children":[["$","h2",null,{"className":"mb-3 text-xl font-bold text-ink dark:text-paper","children":"২. নির্ভুলতা ও ২৪-ঘণ্টা সংশোধন অঙ্গীকার"}],"$L5"]}],"$L6","$L7","$L8","$L9","$La"]}],null,"$Lb"]}],{},null,false]},null,false]},null,false]},null,false],"$Lc",false]],"m":"$undefined","G":["$d",[]],"s":false,"S":true}
